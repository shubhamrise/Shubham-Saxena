  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted Academic Administrators allowed full console management."
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/WebsiteEnquiry" },
      "description": "Write-only public drop box for website enquiries and brochure downloads; admin-only reads and management."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/DirectoryLead" },
      "description": "Admin-managed Leads Directory (promoted website enquiries and campaign leads)."
    },
    "/crm_call_logs/{logId}": {
      "schema": { "$ref": "#/entities/CrmCallLog" },
      "description": "Admin-managed CRM phone call logs and follow-up records."
    },
    "/learners/{learnerId}": {
      "schema": { "$ref": "#/entities/ManagedLearner" },
      "description": "Admin-managed student LMS roster; each verified student can read only their own matching email record."
    },
    "/enrollments/{orderId}": {
      "schema": { "$ref": "#/entities/EnrollmentOrder" },
      "description": "Write-only public drop box for checkout enrollment submissions; admin-only reads and status updates."
    },
    "/email_templates/{templateId}": {
      "schema": { "$ref": "#/entities/EmailTemplate" },
      "description": "Admin-managed reusable candidate outreach email templates."
    },
    "/campaign_batches/{batchId}": {
      "schema": { "$ref": "#/entities/CampaignBatch" },
      "description": "Admin-managed Google Forms / Excel campaign upload batch metadata."
    },
    "/campaign_batches/{batchId}/rows/{rowId}": {
      "schema": { "$ref": "#/entities/CampaignRow" },
      "description": "Individual candidate rows inside a campaign batch subcollection."
    },
    "/lms_modules/{moduleId}": {
      "schema": { "$ref": "#/entities/LmsModuleDoc" },
      "description": "Course curriculum modules synced between Admin Console and verified Student LMS users."
    },
    "/student_progress/{userId}": {
      "schema": { "$ref": "#/entities/StudentProgress" },
      "description": "Per-student completed lesson list, accessible only to the owning authenticated student or admin."
    },
    "/student_progress/{userId}/notes/{lessonId}": {
      "schema": { "$ref": "#/entities/StudentLessonNote" },
      "description": "Per-lesson student notes subcollection, accessible only to the owning authenticated student or admin."
    }
  }
}
