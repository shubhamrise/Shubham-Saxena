{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized Academic Administrator allowed to manage leads, enquiries, learners, CRM call logs, campaigns, templates, and curriculum.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["Academic Administrator", "Admissions Counselor"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "name", "role", "createdAt"]
    },
