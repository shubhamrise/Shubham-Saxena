    "CrmCallLog": {
      "title": "CrmCallLog",
      "description": "Counselor phone interaction record with follow-up schedule and interest classification.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "direction": {
          "type": "string",
          "enum": ["outbound", "inbound"]
        },
        "callStatus": {
          "type": "string",
          "enum": ["Connected", "No Answer", "Callback Requested", "Busy", "Voicemail"]
        },
